---
// The Mac's own landscape screen (640 × 400, the laptop's 16:10), which laptop mode shows on an upright iPhone: the
// space left above the keys is about square, so the Mac keeps its full landscape view and the iPhone shows all of it.
// Part 2 of the hero: "Book a table for seven" is already ticked; the pointer moves to a new row from 6.3 to 7.3 s
// and "Buy flowers" is typed from 8.1 s, a letter every 120 ms.
import { loop, dot } from '../icon';

const menus = [
  { x: 52, text: 'File' },
  { x: 78, text: 'Edit' },
  { x: 104, text: 'Format' },
  { x: 146, text: 'View' },
  { x: 176, text: 'Window' },
  { x: 222, text: 'Help' },
];
const sidebar = ['Recents', 'Applications', 'Desktop', 'Documents', 'Downloads'];
const folders = [
  { x: 110, y: 98, label: 'Remote' },
  { x: 166, y: 98, label: 'Site' },
  { x: 110, y: 160, label: 'Photos' },
  { x: 166, y: 160, label: 'Taxes 2026' },
];
const lights = ['#ff5f57', '#febc2e', '#28c840'];
const dockColors = ['#5d8ef0', '#ff8a8a', '#ffc94d', '#6ccf7f', '#a493e8', '#2a2a2d'];
---

<rect width="640" height="400" fill="#3b3c40" />
<g transform="translate(150 -70) scale(5)">
  <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill="#ff8a8a" />
  <path d={loop} fill="none" stroke="#2c2d31" stroke-width="12.48" stroke-linecap="round" stroke-linejoin="round" />
</g>

<!-- Menu bar -->
<rect width="640" height="20" fill="#1f2023" opacity="0.72" />
<g fill="#fff" opacity="0.92" font-size="11">
  <text x="12" y="14" font-weight="700">Notes</text>
  {menus.map((m) => <text x={m.x} y="14">{m.text}</text>)}
  <rect x="500" y="6" width="13" height="7" rx="2" />
  <rect x="519" y="6" width="11" height="7" rx="3.5" />
  <text x="628" y="14" text-anchor="end">Sat 14 Nov 9:41</text>
</g>

<!-- Finder: Projects -->
<g filter="url(#scene-window-shadow)">
  <rect x="20" y="60" width="230" height="200" rx="9" fill="#fff" />
</g>
<path d="M29 60H96V260H29A9 9 0 0 1 20 251V69A9 9 0 0 1 29 60Z" fill="#f0f1f3" />
{lights.map((c, i) => <circle cx={33 + i * 14} cy="75" r="4.6" fill={c} />)}
<text x="173" y="79" text-anchor="middle" font-size="11.5" font-weight="600" fill="#3a3a3c">Projects</text>
<rect x="26" y="154" width="64" height="15" rx="4" fill="#dfe0e5" />
{sidebar.map((s, i) => <text x="30" y={104 + i * 20} font-size="10.5" fill="#4a4b50">{s}</text>)}
{
  folders.map((f) => (
    <g>
      <rect x={f.x} y={f.y - 4} width="17" height="7" rx="2.5" fill="#4f80e6" />
      <rect x={f.x} y={f.y} width="42" height="30" rx="4" fill="#5d8ef0" />
      <text x={f.x + 21} y={f.y + 44} text-anchor="middle" font-size="9.5" fill="#444">{f.label}</text>
    </g>
  ))
}

<!-- The to-do list: Saturday, "Book a table for seven" already ticked -->
<g filter="url(#scene-window-shadow)">
  <rect x="236" y="36" width="360" height="300" rx="10" fill="#fff" />
</g>
{lights.map((c, i) => <circle cx={251 + i * 15} cy="52" r="5" fill={c} />)}
<text x="416" y="56" text-anchor="middle" font-size="11.5" font-weight="600" fill="#3a3a3c">Saturday</text>
<text x="262" y="98" font-size="25" font-weight="700" fill="#1f1f21">Saturday</text>
<g font-size="17">
  <circle cx="264" cy="136" r="10.75" fill="#ff8a8a" />
  <text x="284" y="142" fill="#9b9ca2">Pick up the film from the lab</text>
  <circle cx="264" cy="174" r="10.75" fill="#ff8a8a" />
  <text x="284" y="180" fill="#9b9ca2">Send Sam the photos</text>
  <circle cx="264" cy="212" r="10.75" fill="#ff8a8a" />
  <text x="284" y="218" fill="#9b9ca2">Book a table for seven</text>
  <circle cx="264" cy="250" r="10" fill="none" stroke="#8d8e94" stroke-width="1.4" />
  <text x="284" y="256" fill="#2c2c2e">Fix the bike’s back light</text>
  <!-- The new to-do: a white cover slides off it a letter at a time, the caret at its edge -->
  <g class="row-new">
    <circle cx="264" cy="288" r="10" fill="none" stroke="#8d8e94" stroke-width="1.4" />
    <text x="284" y="294" fill="#2c2c2e" textLength="86.3" lengthAdjust="spacingAndGlyphs">Buy flowers</text>
    <g class="typed-cover">
      <rect x="285" y="274" width="92" height="26" fill="#fff" />
      <rect x="284" y="278" width="1.4" height="20" fill="#2c2c2e" />
    </g>
  </g>
</g>

<!-- Dock -->
<rect x="200" y="348" width="240" height="40" rx="12" fill="#fff" fill-opacity="0.16" stroke="#fff" stroke-opacity="0.22" />
{dockColors.map((c, i) => <rect x={210 + i * 38} y="354" width="28" height="28" rx="7" fill={c} />)}

<!-- The Mac's pointer -->
<g class="pointer">
  <path
    transform="scale(1.1)"
    d="M0 0V22L5.6 16.9L9.3 25.6L12.9 24.1L9.3 15.6H16.6Z"
    fill="#000"
    stroke="#fff"
    stroke-width="1.6"
    stroke-linejoin="round"
  />
</g>

<style>
  /* The last frame, which is all there is without motion: the new to-do typed, the pointer by it. */
  .pointer {
    transform: translate(316px, 288px);
  }

  .typed-cover {
    transform: translateX(88px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pointer {
      animation: wide-pointer 14s infinite;
    }

    .row-new {
      animation: wide-row 14s infinite;
    }

    .typed-cover {
      animation: wide-typed 14s infinite;
    }

    :global(.hero-scene[data-paused]) :is(.pointer, .row-new, .typed-cover) {
      animation-play-state: paused;
    }
  }

  /* Seconds of the hero's 14 s loop: shown from 5.4 s; the pointer moves 6.3–7.3 s; the row appears at 7.8 s and is
     typed 8.1–9.4 s. Everything resets at the loop's start, while hidden. */
  @keyframes wide-pointer {
    0%,
    45% {
      transform: translate(264px, 212px);
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    52.14%,
    100% {
      transform: translate(316px, 288px);
    }
  }

  @keyframes wide-row {
    0%,
    55.71% {
      opacity: 0;
    }
    56.43%,
    100% {
      opacity: 1;
    }
  }

  @keyframes wide-typed {
    0%,
    57.86% {
      transform: translateX(0);
      animation-timing-function: steps(11, start);
    }
    67.14%,
    100% {
      transform: translateX(88px);
    }
  }
</style>
