---
// The hero: a laptop and an iPhone held upright, both showing the same Mac (drawn like the Figma mockups on page
// "Website screenshots"). Remote's buttons sit in a black bar across the top of the iPhone, so they never cover the
// Mac's picture. The Mac keeps its own landscape screen throughout (MacWide): the laptop fills its display with it,
// and the iPhone fits all of it across its width. A 14 s loop in two parts:
//   1. Full screen: the picture sits in the middle of the iPhone, black above and below. A finger pushes the pointer
//      to a to-do and taps; it ticks.
//   2. Laptop mode (phase 5): keys and a trackpad slide up, and the picture moves up to sit under the bar. A finger on
//      the trackpad moves the pointer below the list and taps, and "Buy flowers" is typed on the keys.
// The loop ends with both screens dipping to black for a moment while everything resets. The screen is drawn once per
// device from the same component, and both copies run the same CSS animations, so they stay in step. Without motion
// (prefers-reduced-motion), the scene rests on its last frame: part 2, typed.
import MacWide from './MacWide.astro';

// The keys in laptop mode. Each key typed in "Buy flowers" lights when it's pressed: the first at 8.1 s into the
// loop, then one every 120 ms.
const typed = 'buy flowers';
const pressedAt = (key: string) => {
  const i = typed.indexOf(key);
  return i < 0 ? undefined : `animation-delay: ${(8.1 + i * 0.12).toFixed(2)}s`;
};
const letterRows = [
  { keys: 'qwertyuiop', x: 12, y: 326 },
  { keys: 'asdfghjkl', x: 31, y: 372 },
  { keys: 'zxcvbnm', x: 69, y: 418 },
];
const keys = [
  ...letterRows.flatMap((row) =>
    [...row.keys].map((k, i) => ({ x: row.x + i * 38, y: row.y, w: 34, label: k.toUpperCase(), style: pressedAt(k) })),
  ),
  { x: 12, y: 418, w: 46, label: '⇧' },
  { x: 342, y: 418, w: 46, label: '⌫' },
  { x: 12, y: 464, w: 78, label: '123' },
  { x: 96, y: 464, w: 208, label: 'space', style: pressedAt(' ') },
  { x: 310, y: 464, w: 78, label: 'return' },
];
---

<div class="hero-scene">
  <svg viewBox="0 0 576 478" role="img" aria-labelledby="scene-title">
    <title id="scene-title">
      A laptop and an iPhone held upright, both showing the same Mac’s landscape screen. On the iPhone, a finger ticks
      the to-do “Book a table for seven”. Then keys and a trackpad slide up on the iPhone, the Mac’s picture moves up
      above them, and “Buy flowers” is typed as a new to-do, appearing on both screens as it’s typed.
    </title>
    <defs>
      <clipPath id="scene-laptop-display"><rect x="51" y="31" width="434" height="271.25" rx="4" /></clipPath>
      <clipPath id="scene-phone-screen"><rect x="407" y="135" width="144" height="312.48" rx="24" /></clipPath>
      <linearGradient id="scene-deck" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e6e8ec" />
        <stop offset="1" stop-color="#b4b7be" />
      </linearGradient>
      <filter id="scene-window-shadow" x="-10%" y="-10%" width="120%" height="135%">
        <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#000" flood-opacity="0.35" />
      </filter>
      <filter id="scene-soft" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>

    <!-- The laptop -->
    <ellipse cx="268" cy="328" rx="262" ry="6" fill="#323232" opacity="0.22" filter="url(#scene-soft)" />
    <rect x="40" y="20" width="456" height="294.5" rx="15" fill="#2b2b2e" stroke="#c3c6cc" stroke-width="1.5" />
    <rect x="51" y="31" width="434" height="271.25" rx="4" fill="#0e0e10" />
    <circle cx="268" cy="25.5" r="1.8" fill="#46474c" />
    <path d="M8 314.5H528V320.5A6 6 0 0 1 522 326.5H14A6 6 0 0 1 8 320.5Z" fill="url(#scene-deck)" />
    <path d="M236 314.5H300V316A3 3 0 0 1 297 319H239A3 3 0 0 1 236 316Z" fill="#a3a6ad" />
    <g clip-path="url(#scene-laptop-display)">
      <g class="desktop" transform="translate(51 31) scale(0.678125)"><MacWide /></g>
      <rect class="blackout" x="51" y="31" width="434" height="271.25" fill="#000" />
    </g>

    <!-- The iPhone -->
    <rect x="404" y="140" width="158" height="326.5" rx="30" fill="#1e1e20" opacity="0.3" filter="url(#scene-soft)" />
    <rect x="400" y="128" width="158" height="326.5" rx="30" fill="#1d1d20" stroke="#8f9198" stroke-width="1.5" />
    <g clip-path="url(#scene-phone-screen)">
      <g transform="translate(407 135) scale(0.36)">
        <rect width="400" height="868" fill="#000" />

        <!-- The Mac's landscape screen across the iPhone's width: in part 1 in the middle of the space below the bar
             (277 lower), in part 2 just under the bar, with keys and a trackpad below -->
        <g class="phone-mac">
          <g class="desktop" transform="translate(0 64) scale(0.625)"><MacWide /></g>
        </g>
        <g class="pad">
          <rect y="314" width="400" height="554" fill="#1b1b1e" />
          {
            keys.map((k) => (
              <g>
                <rect class={k.style ? 'key typed' : 'key'} style={k.style} x={k.x} y={k.y} width={k.w} height="40" rx="6" />
                <text x={k.x + k.w / 2} y={k.y + 26} text-anchor="middle" fill="#fff" font-size={k.label.length > 1 ? 13 : 18}>
                  {k.label}
                </text>
              </g>
            ))
          }
          <rect x="12" y="516" width="376" height="340" rx="18" fill="#2e2f33" stroke="#45464b" stroke-width="1.5" />
        </g>
        <rect class="blackout" y="64" width="400" height="804" fill="#000" />

        <!-- Remote's bar: its buttons either side of the camera, above the Mac's picture -->
        <rect width="400" height="64" fill="#000" />
        <g class="desktop" fill="#fff">
          <text x="18" y="40" font-size="15" opacity="0.6">Local</text>
          <circle cx="286" cy="34" r="11" opacity="0.18" />
          <circle cx="318" cy="34" r="11" opacity="0.18" />
          <circle cx="350" cy="34" r="11" opacity="0.18" />
          <circle cx="382" cy="34" r="11" opacity="0.3" />
        </g>

        <!-- Part 1: a finger on the Mac's picture -->
        <g class="finger">
          <circle r="26" fill="#8e8e93" fill-opacity="0.5" stroke="#fff" stroke-opacity="0.85" stroke-width="3" />
        </g>
        <g class="ring"><circle r="26" fill="none" stroke="#fff" stroke-width="3" /></g>

        <!-- Part 2: a finger on the trackpad -->
        <g class="finger2">
          <circle r="26" fill="#8e8e93" fill-opacity="0.5" stroke="#fff" stroke-opacity="0.85" stroke-width="3" />
        </g>
        <g class="ring2"><circle r="26" fill="none" stroke="#fff" stroke-width="3" /></g>
      </g>
    </g>

    <!-- The iPhone's camera, in Remote's bar -->
    <rect x="461" y="142" width="36" height="10.5" rx="5.25" fill="#000" />
  </svg>

  <button type="button" class="pause" aria-label="Pause the animation" aria-pressed="false">
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <g class="icon-pause"><rect x="5" y="4" width="3.5" height="12" rx="1" /><rect x="11.5" y="4" width="3.5" height="12" rx="1" /></g>
      <path class="icon-play" d="M6 4.2V15.8A.8.8 0 0 0 7.2 16.5L16 10.7A.8.8 0 0 0 16 9.3L7.2 3.5A.8.8 0 0 0 6 4.2Z" />
    </svg>
  </button>
</div>

<script>
  for (const scene of document.querySelectorAll<HTMLElement>('.hero-scene')) {
    const button = scene.querySelector<HTMLButtonElement>('.pause');
    button?.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      scene.toggleAttribute('data-paused', paused);
    });
  }
</script>

<style>
  .hero-scene {
    position: relative;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .desktop {
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', system-ui, sans-serif;
  }

  .key {
    fill: #57585d;
  }

  /* The last frame, which is all there is without motion: part 2, laptop mode, the new to-do typed. */
  .blackout,
  .finger,
  .ring,
  .finger2,
  .ring2 {
    opacity: 0;
  }

  /* The finger sits just below and right of the pointer's tip, so the tip stays visible. */
  .finger,
  .ring {
    transform: translate(183px, 501.5px);
  }

  .finger2,
  .ring2 {
    transform: translate(221px, 719px);
  }

  .ring circle,
  .ring2 circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  .pause {
    display: none;
  }

  /* The 14 s loop, in seconds:
       0–0.3     the screens come up from black
       0.8–2.4   part 1: a finger lands on the Mac's picture and pushes the pointer to "Book a table for seven"
       2.9–3.15  it taps, and the to-do ticks
       5.0–5.7   keys and a trackpad slide up on the iPhone, and the picture moves up to sit under the bar
       6.3–7.3   a finger on the trackpad moves the pointer below the list; it taps at 7.7
       8.1–9.4   "Buy flowers" is typed, a key every 120 ms
       12.6–13.3 the keys slide away and the picture goes back to the middle
       13.4–14   both screens dip to black, and everything resets at 13.8 */
  @media (prefers-reduced-motion: no-preference) {
    .phone-mac {
      animation: phone-mac 14s infinite;
    }

    .blackout {
      animation: blackout 14s infinite;
    }

    .pad {
      animation: pad 14s infinite;
    }

    .finger {
      animation:
        finger-move 14s infinite,
        finger-touch 14s infinite;
    }

    .finger2 {
      animation:
        finger2-move 14s infinite,
        finger2-touch 14s infinite;
    }

    .ring,
    .ring2 {
      opacity: 1;
    }

    .ring circle {
      animation: ring 14s infinite;
    }

    .ring2 circle {
      animation: ring2 14s infinite;
    }

    .key.typed {
      animation: key 14s infinite;
    }

    .hero-scene[data-paused] :is(.phone-mac, .blackout, .pad, .finger, .finger2, circle, .key) {
      animation-play-state: paused;
    }

    .pause {
      position: absolute;
      left: 0.25rem;
      bottom: 0.5rem;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: var(--white);
      color: var(--ink);
      box-shadow: 0 0 0 1px var(--rule);
      cursor: pointer;
    }

    .pause:hover {
      background: #eceef1;
    }

    .pause svg {
      width: 1.1rem;
      height: 1.1rem;
      fill: currentColor;
    }

    .pause .icon-play,
    .pause[aria-pressed='true'] .icon-pause {
      display: none;
    }

    .pause[aria-pressed='true'] .icon-play {
      display: inline;
    }
  }

  /* In step with the pad: the picture's middle position is 277 lower, half of the 554 the keys and trackpad take. */
  @keyframes phone-mac {
    0%,
    35.71% {
      transform: translateY(277px);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    40.71%,
    90% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.2);
    }
    95%,
    100% {
      transform: translateY(277px);
    }
  }

  @keyframes blackout {
    0% {
      opacity: 1;
    }
    2.14%,
    95.71% {
      opacity: 0;
    }
    97.86%,
    100% {
      opacity: 1;
    }
  }

  @keyframes pad {
    0%,
    35.71% {
      transform: translateY(554px);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    40.71%,
    90% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.2);
    }
    95%,
    100% {
      transform: translateY(554px);
    }
  }

  @keyframes finger-move {
    0%,
    7.14% {
      transform: translate(305.5px, 556.5px);
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    17.14%,
    100% {
      transform: translate(183px, 501.5px);
    }
  }

  @keyframes finger-touch {
    0%,
    5.71% {
      opacity: 0;
    }
    7.14%,
    17.14% {
      opacity: 1;
    }
    18.57%,
    20% {
      opacity: 0;
    }
    20.71% {
      opacity: 1;
    }
    21.79%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ring {
    0%,
    21% {
      opacity: 0;
      transform: scale(1);
    }
    21.43% {
      opacity: 0.9;
      transform: scale(1);
    }
    24.29%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  @keyframes finger2-move {
    0%,
    45% {
      transform: translate(140px, 600px);
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    52.14%,
    100% {
      transform: translate(221px, 719px);
    }
  }

  @keyframes finger2-touch {
    0%,
    43.57% {
      opacity: 0;
    }
    45%,
    52.14% {
      opacity: 1;
    }
    52.86%,
    54.29% {
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
    56.07%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ring2 {
    0%,
    55% {
      opacity: 0;
      transform: scale(1);
    }
    55.36% {
      opacity: 0.9;
      transform: scale(1);
    }
    58.57%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  /* A key lights for 140 ms; each typed key's animation-delay is when it's pressed. */
  @keyframes key {
    0%,
    0.7% {
      fill: #a3a5ab;
    }
    1%,
    100% {
      fill: #57585d;
    }
  }
</style>
