---
// The hero: a laptop and a phone held sideways, both showing the same Mac desktop (drawn like the Figma mockups on
// page "Website screenshots"). A finger on the phone moves the Mac's pointer to a to-do and taps; the to-do ticks on
// both screens at once. The Mac's own screen mirrors the phone-shaped screen the Mac adds while connected, so the
// laptop shows it letterboxed, as the real app does.
//
// The desktop is drawn once per screen from the same markup, and both copies run the same CSS animations, so they
// stay in step. Without motion (prefers-reduced-motion), the scene rests on its last frame: the to-do ticked.
import { loop, dot } from '../icon';

// The Mac desktop is 868 × 400, the shape of an iPhone 16 Pro held sideways (2622 × 1206).
const screens = [
  { name: 'laptop', x: 68, y: 69.35, scale: 504 / 868, clip: 'scene-laptop-screen' },
  { name: 'phone', x: 326, y: 326.1, scale: 286 / 868, clip: 'scene-phone-screen' },
];

const folders = [
  { x: 172, y: 118, label: 'Remote' },
  { x: 246, y: 118, label: 'Site' },
  { x: 320, y: 118, label: 'Photos' },
  { x: 172, y: 200, label: 'Taxes 2026' },
];

const sidebar = ['Recents', 'Applications', 'Desktop', 'Documents', 'Downloads'];
const menus = [
  { x: 62, text: 'File' },
  { x: 90, text: 'Edit' },
  { x: 119, text: 'Format' },
  { x: 164, text: 'View' },
  { x: 198, text: 'Window' },
  { x: 248, text: 'Help' },
];
const dockColors = ['#5d8ef0', '#ff8a8a', '#ffc94d', '#6ccf7f', '#a493e8', '#2a2a2d', '#eceef1', '#b6b8be'];
const lights = ['#ff5f57', '#febc2e', '#28c840'];
---

<div class="hero-scene">
  <svg viewBox="0 0 640 490" role="img" aria-labelledby="scene-title">
    <title id="scene-title">
      A laptop and a phone held sideways, both showing the same Mac desktop. A finger on the phone moves the Mac’s
      pointer to the to-do “Book a table for seven” and taps it, and it ticks on both screens at once.
    </title>
    <defs>
      <clipPath id="scene-laptop-screen"><rect x="68" y="28" width="504" height="315" rx="4" /></clipPath>
      <clipPath id="scene-phone-screen"><rect x="326" y="326.1" width="286" height="131.8" rx="23" /></clipPath>
      <linearGradient id="scene-deck" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e6e8ec" />
        <stop offset="1" stop-color="#b4b7be" />
      </linearGradient>
      <filter id="scene-window-shadow" x="-10%" y="-10%" width="120%" height="135%">
        <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#000" flood-opacity="0.35" />
      </filter>
      <filter id="scene-soft" x="-20%" y="-60%" width="140%" height="220%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>

    <!-- The laptop -->
    <ellipse cx="320" cy="371" rx="296" ry="7" fill="#323232" opacity="0.22" filter="url(#scene-soft)" />
    <rect x="56" y="16" width="528" height="340" rx="16" fill="#2b2b2e" stroke="#c3c6cc" stroke-width="1.5" />
    <rect x="68" y="28" width="504" height="315" rx="4" fill="#0e0e10" />
    <circle cx="320" cy="22" r="2" fill="#46474c" />
    <path d="M14 356H626V362.5A6.5 6.5 0 0 1 619.5 369H20.5A6.5 6.5 0 0 1 14 362.5Z" fill="url(#scene-deck)" />
    <path d="M284 356H356V357.5A3 3 0 0 1 353 360.5H287A3 3 0 0 1 284 357.5Z" fill="#a3a6ad" />

    <!-- The phone -->
    <rect x="322" y="330" width="302" height="148" rx="30" fill="#1e1e20" opacity="0.3" filter="url(#scene-soft)" />
    <rect x="318" y="318" width="302" height="148" rx="30" fill="#1d1d20" stroke="#8f9198" stroke-width="1.5" />
    <rect x="326" y="326.1" width="286" height="131.8" rx="23" fill="#0e0e10" />

    {
      screens.map((screen) => (
        <g clip-path={`url(#${screen.clip})`}>
          <g class="desktop" transform={`translate(${screen.x} ${screen.y}) scale(${screen.scale})`}>
            {/* Wallpaper: the icon's circle and loop, large */}
            <rect width="868" height="400" fill="#3b3c40" />
            <g transform="translate(120 -110) scale(6.4)">
              <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill="#ff8a8a" />
              <path d={loop} fill="none" stroke="#2c2d31" stroke-width="12.48" stroke-linecap="round" stroke-linejoin="round" />
            </g>

            {/* Menu bar */}
            <rect width="868" height="22" fill="#1f2023" opacity="0.72" />
            <g class="menu" fill="#fff" opacity="0.92">
              <text x="16" y="15" font-weight="700">Notes</text>
              {menus.map((m) => <text x={m.x} y="15">{m.text}</text>)}
              <text x="852" y="15" text-anchor="end">Sat 14 Nov  9:41</text>
              <rect x="726" y="7" width="15" height="8" rx="2" />
              <rect x="748" y="7" width="12" height="8" rx="4" />
            </g>

            {/* Finder: Projects */}
            <g filter="url(#scene-window-shadow)">
              <rect x="48" y="74" width="360" height="232" rx="10" fill="#fff" />
            </g>
            <path d="M58 74H150V306H58A10 10 0 0 1 48 296V84A10 10 0 0 1 58 74Z" fill="#f0f1f3" />
            {lights.map((c, i) => <circle cx={66 + i * 16} cy="90" r="5.2" fill={c} />)}
            <text class="title" x="279" y="94" text-anchor="middle">Projects</text>
            <rect x="56" y="180" width="88" height="18" rx="5" fill="#dfe0e5" />
            {sidebar.map((s, i) => <text class="side" x="62" y={126 + i * 22}>{s}</text>)}
            {folders.map((f) => (
              <g>
                <rect x={f.x} y={f.y - 5} width="20" height="9" rx="3" fill="#4f80e6" />
                <rect x={f.x} y={f.y} width="50" height="36" rx="5" fill="#5d8ef0" />
                <text class="file" x={f.x + 25} y={f.y + 52} text-anchor="middle">{f.label}</text>
              </g>
            ))}
            <rect x="254" y="194" width="34" height="44" rx="4" fill="#ff8a8a" />
            <text class="file" x="271" y="254" text-anchor="middle">Plan.pdf</text>
            <rect x="331" y="194" width="34" height="44" rx="4" fill="#6ccf7f" />
            <text class="file" x="348" y="254" text-anchor="middle">Budget</text>

            {/* The to-do list: Saturday */}
            <g filter="url(#scene-window-shadow)">
              <rect x="392" y="58" width="430" height="262" rx="10" fill="#fff" />
            </g>
            {lights.map((c, i) => <circle cx={410 + i * 16} cy="74" r="5.2" fill={c} />)}
            <text class="title" x="607" y="78" text-anchor="middle">Saturday</text>
            <text x="424" y="124" font-size="27" font-weight="700" fill="#1f1f21">Saturday</text>
            <g font-size="17">
              <circle cx="432" cy="160" r="9.75" fill="#ff8a8a" />
              <text x="452" y="166" fill="#9b9ca2">Pick up the film from the lab</text>
              <circle cx="432" cy="198" r="9.75" fill="#ff8a8a" />
              <text x="452" y="204" fill="#9b9ca2">Send Sam the photos</text>
              <circle cx="432" cy="236" r="9" fill="none" stroke="#8d8e94" stroke-width="1.5" />
              <circle class="tick" cx="432" cy="236" r="9.75" fill="#ff8a8a" />
              <text class="todo" x="452" y="242">Book a table for seven</text>
              <circle cx="432" cy="274" r="9" fill="none" stroke="#8d8e94" stroke-width="1.5" />
              <text x="452" y="280" fill="#2c2c2e">Fix the bike’s back light</text>
            </g>

            {/* Dock */}
            <rect x="262" y="346" width="344" height="44" rx="13" fill="#fff" fill-opacity="0.16" stroke="#fff" stroke-opacity="0.22" />
            {dockColors.map((c, i) => <rect x={272 + i * 41} y="353" width="30" height="30" rx="8" fill={c} />)}

            {/* The Mac's pointer */}
            <g class="pointer">
              <path
                d="M0 0V22L5.6 16.9L9.3 25.6L12.9 24.1L9.3 15.6H16.6Z"
                fill="#000"
                stroke="#fff"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
            </g>

            {
              screen.name === 'phone' && (
                <g>
                  {/* Remote's controls, over the Mac's screen */}
                  <g fill="#fff">
                    <text x="56" y="47" font-size="15" opacity="0.6">Local</text>
                    <rect x="596" y="29" width="104" height="26" rx="13" opacity="0.14" />
                    <text x="648" y="47" font-size="13" text-anchor="middle" opacity="0.8">Trackpad</text>
                    <circle cx="726" cy="42" r="12" opacity="0.14" />
                    <circle cx="764" cy="42" r="12" opacity="0.14" />
                    <circle cx="802" cy="42" r="12" opacity="0.14" />
                    <circle cx="840" cy="42" r="12" opacity="0.24" />
                  </g>
                  {/* A finger on the phone's glass */}
                  <g class="finger">
                    <circle r="22" fill="#8e8e93" fill-opacity="0.5" stroke="#fff" stroke-opacity="0.85" stroke-width="2.5" />
                  </g>
                  <g class="ring">
                    <circle r="22" fill="none" stroke="#fff" stroke-width="2.5" />
                  </g>
                </g>
              )
            }
          </g>
        </g>
      ))
    }

    <!-- The phone's camera, over its screen -->
    <rect x="332" y="371" width="9" height="42" rx="4.5" fill="#000" />
  </svg>

  <button type="button" class="pause" aria-label="Pause the animation" aria-pressed="false">
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <g class="icon-pause"><rect x="5" y="4" width="3.5" height="12" rx="1" /><rect x="11.5" y="4" width="3.5" height="12" rx="1" /></g>
      <path class="icon-play" d="M6 4.2V15.8A.8.8 0 0 0 7.2 16.5L16 10.7A.8.8 0 0 0 16 9.3L7.2 3.5A.8.8 0 0 0 6 4.2Z" />
    </svg>
  </button>
</div>

<script>
  for (const scene of document.querySelectorAll<HTMLElement>('.hero-scene')) {
    const button = scene.querySelector<HTMLButtonElement>('.pause');
    button?.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      scene.toggleAttribute('data-paused', paused);
    });
  }
</script>

<style>
  .hero-scene {
    position: relative;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .desktop {
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', system-ui, sans-serif;
    font-size: 11.5px;
  }

  .title {
    font-size: 12.5px;
    font-weight: 600;
    fill: #3a3a3c;
  }

  .side {
    fill: #4a4b50;
  }

  .file {
    font-size: 10.5px;
    fill: #444;
  }

  /* The last frame, which is all there is without motion: the pointer on the to-do, the to-do ticked. */
  .pointer {
    transform: translate(432px, 236px);
  }

  .todo {
    fill: #9b9ca2;
  }

  .finger,
  .ring {
    opacity: 0;
  }

  .finger {
    transform: translate(448px, 262px);
  }

  .ring {
    transform: translate(448px, 262px);
  }

  .ring circle,
  .tick {
    transform-box: fill-box;
    transform-origin: center;
  }

  .pause {
    display: none;
  }

  /* A 7 s loop: rest; the finger lands and pushes the pointer to the to-do; it lifts and taps; the to-do ticks on
     both screens; rest; fade back to the start. */
  @media (prefers-reduced-motion: no-preference) {
    .pointer {
      animation:
        pointer-move 7s infinite,
        pointer-fade 7s infinite;
    }

    .finger {
      animation:
        finger-move 7s infinite,
        finger-touch 7s infinite;
    }

    .ring {
      opacity: 1;
    }

    .ring circle {
      animation: ring 7s infinite;
    }

    .tick {
      animation: tick 7s infinite;
    }

    .todo {
      animation: todo 7s infinite;
    }

    .hero-scene[data-paused] :is(.pointer, .finger, .ring circle, .tick, .todo) {
      animation-play-state: paused;
    }

    .pause {
      position: absolute;
      left: 0.25rem;
      bottom: 0.5rem;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: var(--white);
      color: var(--ink);
      box-shadow: 0 0 0 1px var(--rule);
      cursor: pointer;
    }

    .pause:hover {
      background: #eceef1;
    }

    .pause svg {
      width: 1.1rem;
      height: 1.1rem;
      fill: currentColor;
    }

    .pause .icon-play,
    .pause[aria-pressed='true'] .icon-pause {
      display: none;
    }

    .pause[aria-pressed='true'] .icon-play {
      display: inline;
    }
  }

  @keyframes pointer-move {
    0%,
    14% {
      transform: translate(296px, 176px);
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    34%,
    92% {
      transform: translate(432px, 236px);
    }
    93%,
    100% {
      transform: translate(296px, 176px);
    }
  }

  @keyframes pointer-fade {
    0%,
    89% {
      opacity: 1;
    }
    91%,
    96% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes finger-move {
    0%,
    14% {
      transform: translate(312px, 202px);
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    34%,
    100% {
      transform: translate(448px, 262px);
    }
  }

  @keyframes finger-touch {
    0%,
    11% {
      opacity: 0;
    }
    14%,
    34% {
      opacity: 1;
    }
    37%,
    40% {
      opacity: 0;
    }
    41.5% {
      opacity: 1;
    }
    43.5%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ring {
    0%,
    42% {
      opacity: 0;
      transform: scale(1);
    }
    42.5% {
      opacity: 0.9;
      transform: scale(1);
    }
    49%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  @keyframes tick {
    0%,
    43% {
      opacity: 0;
      transform: scale(0.4);
    }
    45% {
      opacity: 1;
      transform: scale(1.18);
    }
    47.5%,
    88% {
      opacity: 1;
      transform: scale(1);
    }
    93%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  @keyframes todo {
    0%,
    43% {
      fill: #2c2c2e;
    }
    45%,
    88% {
      fill: #9b9ca2;
    }
    93%,
    100% {
      fill: #2c2c2e;
    }
  }
</style>
